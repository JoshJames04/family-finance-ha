    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  }
}
